local soundService = game:GetService("SoundService")

local player = players.LocalPlayer
local isExecuting = false
local processedKills = {}
local activeComboTargets = {}
local activeJumpConnection = nil
local activeAnimTrack = nil

local vfxModule = replicatedStorage:FindFirstChild("Emotes") and replicatedStorage.Emotes:FindFirstChild("VFX")

local playerModuleScript = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5)
local controls = playerModuleScript and require(playerModuleScript):GetControls()

local INPUT_BLOCK_NAME = "FinisherInputBlock"

local function blockInputs(actionName, inputState, inputObject)
    return Enum.ContextActionResult.Sink
end

local function lockControls()
    if controls then
        controls:Disable()
    end
    
    contextActionService:BindActionAtPriority(
        INPUT_BLOCK_NAME,
        blockInputs,
        false,
        Enum.ContextActionPriority.High.Value + 100,
        Enum.KeyCode.One,
        Enum.KeyCode.Two,
        Enum.KeyCode.Three,
        Enum.KeyCode.Four,
        Enum.KeyCode.Q,
        Enum.KeyCode.Space,
        Enum.UserInputType.MouseButton1
    )
end

local function unlockControls()
    contextActionService:UnbindAction(INPUT_BLOCK_NAME)
    if controls then
        controls:Enable()
    end
end

local cancelWCS

local function playDismantleStartup()
    local char = player.Character or player.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    lockControls()

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://133818134745501[span_0](start_span)"[span_0](end_span)
    activeAnimTrack = humanoid:LoadAnimation(anim)
    activeAnimTrack:Play()

    task.delay(0.1, function()
        if not isExecuting then return end
        local existingEffect = char:FindFirstChild("DismantleEffect")
        if existingEffect then
            existingEffect:Destroy()
        end

        local accessory = Instance.new("Accessory")
        accessory.Name = "DismantleEffect"
        accessory.Parent = char
        accessory:SetAttribute("EmoteEffect", true)[span_1](start_span)[span_1](end_span)

        if vfxModule then
            pcall(function()
                require(vfxModule):MainFunction({
                    Character = char,
                    vfxName = "Pride",[span_2](start_span)[span_2](end_span)
                    SpecificModule = vfxModule,
                    AnimSent = 133818134745501,[span_3](start_span)[span_3](end_span)
                    RealBind = accessory,
                    CanRotate = true[span_4](start_span)[span_4](end_span)
                })
            end)
        end

        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if torso then
            local sound = Instance.new("Sound")
            sound.SoundId = "rbxassetid://93369149563360[span_5](start_span)"[span_5](end_span)
            sound.Volume = 2
            sound.Looped = false
            sound.Parent = torso
            sound:Play()
            game.Debris:AddItem(sound, 5)[span_6](start_span)[span_6](end_span)
        end
    end)

    activeJumpConnection = humanoid.StateChanged:Connect(function(old, new)
        if new == Enum.HumanoidStateType.Jumping then
            cancelWCS()
        end
    end)
end

local function triggerFinisher(targetCharacter)
    if isExecuting then return end
    isExecuting = true

    playDismantleStartup()

    local char = player.Character or player.CharacterAdded:Wait()
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    local humanoid = char:WaitForChild("Humanoid")
    
    if not rootPart then 
        isExecuting = false
        unlockControls()
        return 
    end

    humanoid.PlatformStand = false
    humanoid.AutoRotate = false

    local cloneTarget = targetCharacter and targetCharacter:Clone() or nil
    local activeWeld = nil

    if cloneTarget then
        cloneTarget.Name = "ExecutionClone"
        cloneTarget.Parent = workspace

        for _, obj in ipairs(targetCharacter:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Accessory") then
                pcall(function() obj.Transparency = 1 end)
            end
        end
        task.delay(0.1, function()
            if targetCharacter then targetCharacter:Destroy() end
        end)

        local cloneHumanoid = cloneTarget:FindFirstChildOfClass("Humanoid")
        if cloneHumanoid then cloneHumanoid:Destroy() end

        local cloneRoot = cloneTarget:FindFirstChild("HumanoidRootPart") or cloneTarget:FindFirstChild("Torso")
        
        for _, part in ipairs(cloneTarget:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
                part.Massless = true
                part.Anchored = false
            end
        end

        if cloneRoot then
            cloneRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.rad(180), 0)
            
            activeWeld = Instance.new("WeldConstraint")
            activeWeld.Part0 = rootPart
            activeWeld.Part1 = cloneRoot
            activeWeld.Parent = cloneRoot
        end
    end

    local soundConfigs = {
        {SoundId = "rbxassetid://113267998039039", Volume = 1.65, ParentTorso = true}
    }
    
    for _, cfg in ipairs(soundConfigs) do
        local snd = Instance.new("Sound")
        snd.SoundId = cfg.SoundId
        snd.Volume = cfg.Volume or 1
        snd.Looped = cfg.Looped or false
        snd.Parent = (cfg.ParentTorso and torso) or workspace
        snd:Play()
        game.Debris:AddItem(snd, 5)
    end
    
    local extraSound = Instance.new("Sound")
    extraSound.SoundId = "rbxassetid://87401852788032"
    extraSound.Volume = 1
    extraSound.Parent = workspace
    extraSound:Play()
    game.Debris:AddItem(extraSound, 5)

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://95171537920426"
    activeAnimTrack = humanoid:LoadAnimation(anim)
    activeAnimTrack:Play()
    
    local animLength = activeAnimTrack.Length > 0 and activeAnimTrack.Length or 1.5
    local forwardDistance = 23 * (animLength * 0.6)
    
    local targetCFrame = rootPart.CFrame * CFrame.new(0, 0, -forwardDistance)
    local tweenInfo = TweenInfo.new(animLength, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local moveTween = tweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    moveTween:Play()
    
    local accessory = Instance.new("Accessory")
    accessory.Name = "#EmoteHolder_" .. math.random(1, 100000)
    accessory.Parent = char
    accessory:SetAttribute("EmoteProperty", true)
    
    if vfxModule then
        pcall(function()
            require(vfxModule):MainFunction({
                Character = char,
                vfxName = "slice combo",
                SpecificModule = require(vfxModule),
                AnimSent = 95171537920426,
                RealBind = accessory
            })
        end)
    end
    
    activeAnimTrack.Stopped:Connect(function()
        if not isExecuting then return end
        if moveTween then
            moveTween:Cancel()
        end

        if activeJumpConnection then
            activeJumpConnection:Disconnect()
            activeJumpConnection = nil
        end

        unlockControls()

        if humanoid and humanoid.Parent then
            humanoid.AutoRotate = true
        end

        if activeWeld then
            activeWeld:Destroy()
        end

        if cloneTarget and cloneTarget.Parent then
            for _, desc in ipairs(cloneTarget:GetDescendants()) do
                if desc:IsA("Motor6D") then
                    desc:Destroy()
                elseif desc:IsA("BasePart") then
                    desc.CanCollide = true
                    desc.Massless = false
                    desc.Anchored = false
                    desc.AssemblyLinearVelocity = Vector3.new(math.random(-30, 30), math.random(25, 45), math.random(-30, 30))
                    desc.AssemblyAngularVelocity = Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
                end
            end
            
            game.Debris:AddItem(cloneTarget, 5)
        end
        
        local dismantleEffect = char:FindFirstChild("DismantleEffect")
        if dismantleEffect then
            dismantleEffect:Destroy()
        end

        task.wait(1)
        isExecuting = false
    end)
end

cancelWCS = function()
    if not isExecuting then return end
    
    if activeJumpConnection then
        activeJumpConnection:Disconnect()
        activeJumpConnection = nil
    end

    if activeAnimTrack then
        pcall(function() activeAnimTrack:Stop() end)
        activeAnimTrack = nil
    end

    unlockControls()

    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.AutoRotate = true
        end
        local dismantleEffect = char:FindFirstChild("DismantleEffect")
        if dismantleEffect then
            dismantleEffect:Destroy()
        end
    end

    isExecuting = false
end

local function giveTool()
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end

    if not backpack:FindFirstChild("World Cutting Slash") and not (player.Character and player.Character:FindFirstChild("World Cutting Slash")) then
        local tool = Instance.new("Tool")
        tool.Name = "World Cutting Slash"
        tool.RequiresHandle = false
        tool.Parent = backpack

        tool.Activated:Connect(function()
            if isExecuting then return end
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local targetFound = nil

            if root then
                for _, other in ipairs(workspace:GetChildren()) do
                    if other:IsA("Model") and other ~= char and other:FindFirstChild("Humanoid") then
                        local otherRoot = other:FindFirstChild("HumanoidRootPart") or other:FindFirstChild("Torso")
                        if otherRoot and (otherRoot.Position - root.Position).Magnitude <= 15 then
                            targetFound = other
                            break
                        end
                    end
                end
            end

            if targetFound then
                triggerFinisher(targetFound)
            else
                playDismantleStartup()
            end
        end)
    end
end

player.CharacterAdded:Connect(function()
    task.wait(1)
    giveTool()
end)
giveTool()

