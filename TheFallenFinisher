local players = game:GetService("Players")
local replicatedStorage = game:GetService("ReplicatedStorage")
local workspace = game:GetService("Workspace")
local runService = game:GetService("RunService")
local tweenService = game:GetService("TweenService")
local contextActionService = game:GetService("ContextActionService")

local player = players.LocalPlayer
local isExecuting = false
local processedKills = {}
local activeComboTargets = {}

local vfxModule = replicatedStorage:FindFirstChild("Emotes") and replicatedStorage.Emotes:FindFirstChild("VFX")

-- Get Player controls module safely for locking WASD movement
local playerModuleScript = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5)
local controls = playerModuleScript and require(playerModuleScript):GetControls()

local INPUT_BLOCK_NAME = "FinisherInputBlock"

local function blockInputs(actionName, inputState, inputObject)
    return Enum.ContextActionResult.Sink -- Blocks the input from doing anything else
end

--[Finisher Structure with Full Input Lockdown, Tween Movement & Ragdoll Debris]
local function triggerFinisher(targetCharacter)
    if isExecuting or processedKills[targetCharacter] then return end
    isExecuting = true
    processedKills[targetCharacter] = true

    local char = player.Character or player.CharacterAdded:Wait()
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    local humanoid = char:WaitForChild("Humanoid")
    
    if not rootPart then 
        isExecuting = false
        return 
    end

    -- LOCK ALL CONTROLS (WASD, Jump, 1-4, Q, M1)
    if controls then
        controls:Disable()
    end
    
    contextActionService:BindActionAtPriority(
        INPUT_BLOCK_NAME,
        blockInputs,
        false,
        Enum.ContextActionPriority.High.Value + 100,
        Enum.KeyCode.One,
        Enum.KeyCode.Two,
        Enum.KeyCode.Three,
        Enum.KeyCode.Four,
        Enum.KeyCode.Q,
        Enum.KeyCode.Space,
        Enum.UserInputType.MouseButton1
    )

    humanoid.PlatformStand = false
    humanoid.AutoRotate = false

    -- Create a lightweight clone of the target
    local cloneTarget = targetCharacter:Clone()
    cloneTarget.Name = "ExecutionClone"
    cloneTarget.Parent = workspace

    -- Hide and destroy the original target instantly
    for _, obj in ipairs(targetCharacter:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Accessory") then
            pcall(function() obj.Transparency = 1 end)
        end
    end
    task.delay(0.1, function()
        if targetCharacter then targetCharacter:Destroy() end
    end)

    local cloneHumanoid = cloneTarget:FindFirstChildOfClass("Humanoid")
    if cloneHumanoid then cloneHumanoid:Destroy() end

    local cloneRoot = cloneTarget:FindFirstChild("HumanoidRootPart") or cloneTarget:FindFirstChild("Torso")
    
    for _, part in ipairs(cloneTarget:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Massless = true
            part.Anchored = false
        end
    end

    local activeWeld = nil
    if cloneRoot then
        cloneRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.rad(180), 0)
        
        activeWeld = Instance.new("WeldConstraint")
        activeWeld.Part0 = rootPart
        activeWeld.Part1 = cloneRoot
        activeWeld.Parent = cloneRoot
    end

    local soundConfigs = {
        {SoundId = "rbxassetid://113267998039039", Volume = 1.65, ParentTorso = true}
    }
    
    for _, cfg in ipairs(soundConfigs) do
        local snd = Instance.new("Sound")
        snd.SoundId = cfg.SoundId
        snd.Volume = cfg.Volume or 1
        snd.Looped = cfg.Looped or false
        snd.Parent = (cfg.ParentTorso and torso) or workspace
        snd:Play()
        game.Debris:AddItem(snd, 5)
    end
    
    local extraSound = Instance.new("Sound")
    extraSound.SoundId = "rbxassetid://87401852788032"
    extraSound.Volume = 1
    extraSound.Parent = workspace
    extraSound:Play()
    game.Debris:AddItem(extraSound, 5)

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://95171537920426"
    local animTrack = humanoid:LoadAnimation(anim)
    animTrack:Play()
    
    -- Smooth straight-line tween forward
    local animLength = animTrack.Length > 0 and animTrack.Length or 1.5
    local forwardDistance = 23 * (animLength * 0.6)
    
    local targetCFrame = rootPart.CFrame * CFrame.new(0, 0, -forwardDistance)
    local tweenInfo = TweenInfo.new(animLength, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local moveTween = tweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    moveTween:Play()
    
    local accessory = Instance.new("Accessory")
    accessory.Name = "#EmoteHolder_" .. math.random(1, 100000)
    accessory.Parent = char
    accessory:SetAttribute("EmoteProperty", true)
    
    if vfxModule then
        pcall(function()
            require(vfxModule):MainFunction({
                Character = char,
                vfxName = "slice combo",
                SpecificModule = require(vfxModule),
                AnimSent = 95171537920426,
                RealBind = accessory
            })
        end)
    end
    
    -- When animation stops, release controls, break weld, and turn clone into a ragdoll explosion
    animTrack.Stopped:Connect(function()
        if moveTween then
            moveTween:Cancel()
        end

        -- RESTORE ALL CONTROLS
        contextActionService:UnbindAction(INPUT_BLOCK_NAME)
        if controls then
            controls:Enable()
        end

        if humanoid and humanoid.Parent then
            humanoid.AutoRotate = true
        end

        if activeWeld then
            activeWeld:Destroy()
        end

        if cloneTarget and cloneTarget.Parent then
            for _, desc in ipairs(cloneTarget:GetDescendants()) do
                if desc:IsA("Motor6D") then
                    desc:Destroy()
                elseif desc:IsA("BasePart") then
                    desc.CanCollide = true
                    desc.Massless = false
                    desc.Anchored = false
                    desc.AssemblyLinearVelocity = Vector3.new(math.random(-30, 30), math.random(25, 45), math.random(-30, 30))
                    desc.AssemblyAngularVelocity = Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
                end
            end
            
            game.Debris:AddItem(cloneTarget, 5)
        end
        
        task.wait(1)
        isExecuting = false
    end)
end

local function monitorCharacter(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    
    local lastHealth = humanoid.Health
    humanoid.HealthChanged:Connect(function(health)
        if health <= 0 and lastHealth > 0 and not processedKills[char] and not isExecuting then
            local hitTime = activeComboTargets[char]
            if hitTime and (os.clock() - hitTime <= 0.4) then
                local myChar = player.Character
                local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                
                if root and myRoot and (root.Position - myRoot.Position).Magnitude <= 12 then
                    triggerFinisher(char)
                end
            end
        end
        lastHealth = health
    end)
end

local function setupAttributeListener()
    local myChar = player.Character or player.CharacterAdded:Wait()
    myChar:GetAttributeChangedSignal("LastM1Hitted"):Connect(function()
        local lastHit = myChar:GetAttribute("LastM1Hitted")
        if lastHit then
            local targetName = tostring(lastHit):match("([^;]+)")
            if targetName then
                local targetChar = workspace:FindFirstChild(targetName) 
                    or (workspace:FindFirstChild("Live") and workspace.Live:FindFirstChild(targetName))
                
                if targetChar then
                    activeComboTargets[targetChar] = os.clock()
                end
            end
        end
    end)
end

setupAttributeListener()
player.CharacterAdded:Connect(setupAttributeListener)

local monitoredCharacters = {}
local function setupPlayer(p)
    if p == player then return end
    p.CharacterAdded:Connect(function(char)
        if not monitoredCharacters[char] then
            monitoredCharacters[char] = true
            processedKills[char] = nil
            activeComboTargets[char] = nil
            monitorCharacter(char)
        end
    end)
    if p.Character and not monitoredCharacters[p.Character] then
        monitoredCharacters[p.Character] = true
        monitorCharacter(p.Character)
    end
end

for _, p in ipairs(players:GetPlayers()) do
    setupPlayer(p)
end
players.PlayerAdded:Connect(setupPlayer)

local function scanForDummies(parent)
    for _, obj in ipairs(parent:GetChildren()) do
        if obj:IsA("Model") and obj ~= player.Character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and not players:GetPlayerFromCharacter(obj) then
                if not monitoredCharacters[obj] then
                    monitoredCharacters[obj] = true
                    monitorCharacter(obj)
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        scanForDummies(workspace)
        if workspace:FindFirstChild("Live") then
            scanForDummies(workspace.Live)
        end
        task.wait(1)
    end
end)
